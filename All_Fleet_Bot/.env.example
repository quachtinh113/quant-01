# =====================================================================
# UNIFIED QUANT FLEET — Environment Variables Example
# Duplicate this file to .env and insert your broker credentials
# =====================================================================

# --- Primary MT5 Terminal (Single Terminal / Master Account) ---
MT5_ACCOUNT=your_account_number_here
MT5_PASSWORD=your_password_here
MT5_SERVER=Exness-MT5Trial14
MT5_PATH=C:\Program Files\MetaTrader 5 EXNESS\terminal64.exe

# Execution Mode: true for real order sending, false for paper/shadow dry-run
LIVE_TRADING=true

# --- Risk Limits ---
MAX_DAILY_DRAWDOWN_USD=300.0
MIN_MARGIN_LEVEL_PERCENT=200.0
